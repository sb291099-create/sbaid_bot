# Скопируйте в .env и заполните. Файл .env не должен попадать в git.

# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram id (узнать: @userinfobot). Этот аккаунт становится основателем (админом).
FOUNDER_TELEGRAM_ID=
# Можно не заполнять: бот сам запоминает канал и группу, когда основатель
# добавляет его туда администратором. Значения здесь имеют приоритет.
PUBLIC_CHANNEL_ID=
SHAREHOLDERS_GROUP_ID=

# Домен сервера для HTTPS (нужен для уведомлений Robokassa). install.sh подставит
# адрес вида 1-2-3-4.sslip.io; позже можно заменить на свой домен.
DOMAIN=

POSTGRES_PASSWORD=
# Ключ шифрования реквизитов продавцов. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеряете ключ — потеряете реквизиты. Храните копию отдельно от сервера.
ENCRYPTION_KEY=

TOTAL_SHARES=1000000

# Названия для сообщений бота
FOUNDER_NAME=Сергей Борзунов
# Одинарные кавычки нужны, чтобы знак $ не воспринимался как переменная
CHANNEL_NAME='Сергей Борзунов · $SBAID'
# Ссылка на открытый канал, например https://t.me/sbaid
CHANNEL_URL=
GROUP_NAME=SBAID Holders

# Юридические тексты (без них бот запускать нельзя)
OFFER_URL=
OFFER_VERSION=1.0
RULES_URL=
PRIVACY_URL=

# Robokassa. ResultURL в настройках магазина: https://ВАШ_ДОМЕН/robokassa/result (метод POST)
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Пароль №3 нужен для автоматических возвратов; без него возвраты проводятся вручную
ROBOKASSA_PASSWORD3=
# 1 — тестовый режим, 0 — боевой
ROBOKASSA_TEST_MODE=1
# usn_income — ИП на УСН «доходы»; usn_income_outcome — «доходы минус расходы»; npd — самозанятый
ROBOKASSA_SNO=usn_income
RECEIPT_ITEM_NAME=Участие в клубе SBAID, {n} голосов
